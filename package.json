{
  "name": "speech-model-demos",
  "version": "0.2.10",
  "private": true,
  "description": "Browser-local speech pipeline proof of concept: microphone -> Parakeet ASR -> transcript -> Kokoro TTS -> speaker, with benchmark instrumentation.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:packages": "tsc -b packages/speech-to-text packages/text-to-speech",
    "dev:packages": "tsc -b -w packages/speech-to-text packages/text-to-speech",
    "pack:packages": "npm run build:packages && npm pack --pack-destination .tarballs -w packages/core -w packages/text-to-speech -w packages/speech-to-text",
    "predev": "npm run build:packages && node scripts/copy-ort-assets.mjs",
    "dev": "next dev",
    "prebuild": "npm run build:packages && node scripts/copy-ort-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/network-lock.mjs",
    "preview": "node scripts/serve-out.mjs",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "test": "vitest run",
    "copy-ort-assets": "node scripts/copy-ort-assets.mjs",
    "mirror-models": "node scripts/mirror-models-to-r2.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@localspeech/core": "0.1.0",
    "@localspeech/speech-to-text": "0.1.0",
    "@localspeech/text-to-speech": "0.1.0",
    "next": "16.3.8",
    "onnxruntime-web": "1.24.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
