{
  "name": "speech-model-demos",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-local speech pipeline proof of concept: microphone -> Parakeet ASR -> transcript -> Kokoro TTS -> speaker, with benchmark instrumentation.",
  "scripts": {
    "predev": "node scripts/copy-ort-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ort-assets.mjs",
    "build": "next build",
    "preview": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "copy-ort-assets": "node scripts/copy-ort-assets.mjs",
    "mirror-models": "node scripts/mirror-models-to-r2.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1",
    "next": "16.3.8",
    "onnxruntime-web": "1.24.1",
    "parakeet.js": "1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
