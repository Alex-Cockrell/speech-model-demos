{
  "name": "@localspeech/core",
  "version": "0.1.0",
  "description": "Shared plumbing for @localspeech packages: model download instrumentation, caches, environment detection.",
  "keywords": [
    "speech",
    "browser",
    "onnxruntime-web",
    "webgpu",
    "wasm",
    "on-device"
  ],
  "license": "MIT",
  "author": "Alex Cockrell",
  "homepage": "https://github.com/Alex-Cockrell/speech-model-demos/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Alex-Cockrell/speech-model-demos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex-Cockrell/speech-model-demos.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
