{
  "name": "@localspeech/speech-to-text",
  "version": "0.1.0",
  "description": "Live speech-to-text that runs entirely in the browser (Parakeet TDT v3 on WebGPU or WASM).",
  "keywords": [
    "speech-to-text",
    "speech-recognition",
    "asr",
    "dictation",
    "transcription",
    "parakeet",
    "browser",
    "webgpu",
    "wasm",
    "on-device",
    "privacy",
    "react",
    "assistant-ui"
  ],
  "license": "MIT",
  "author": "Alex Cockrell",
  "homepage": "https://github.com/Alex-Cockrell/speech-model-demos/tree/main/packages/speech-to-text#readme",
  "bugs": {
    "url": "https://github.com/Alex-Cockrell/speech-model-demos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex-Cockrell/speech-model-demos.git",
    "directory": "packages/speech-to-text"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./assistant-ui": {
      "types": "./dist/assistant-ui.d.ts",
      "import": "./dist/assistant-ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@localspeech/core": "0.1.0",
    "onnxruntime-web": "1.24.1",
    "parakeet.js": "1.4.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
