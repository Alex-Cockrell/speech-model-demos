{
  "name": "@localspeech/text-to-speech",
  "version": "0.1.0",
  "private": true,
  "description": "Streaming text-to-speech that runs entirely in the browser (Kokoro 82M on WebGPU or WASM).",
  "license": "MIT",
  "author": "Alex Cockrell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./assistant-ui": {
      "types": "./dist/assistant-ui.d.ts",
      "import": "./dist/assistant-ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@localspeech/core": "0.1.0",
    "onnxruntime-web": "1.24.1",
    "phonemizer": "1.2.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "@assistant-ui/react": ">=0.15 <0.16"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@assistant-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.28"
  }
}
